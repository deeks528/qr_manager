<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_default_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Subtle bottom-right wave watermark -->
    <ImageView
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/ic_widget_wave_bg" />

    <!-- Top Header: Avatar + Nickname + Chevron [H] Hcl › -->
    <RelativeLayout
        android:id="@+id/widget_default_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <!-- Dynamic Avatar (Initials Bitmap) -->
        <ImageView
            android:id="@+id/widget_default_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Profile Avatar"
            android:scaleType="fitCenter" />

        <!-- Circular Chevron Button (›) -->
        <FrameLayout
            android:id="@+id/widget_default_arrow"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_arrow_bg">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_small" />
        </FrameLayout>

        <!-- Profile Nickname Title -->
        <TextView
            android:id="@+id/widget_default_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@id/widget_default_arrow"
            android:layout_toEndOf="@id/widget_default_avatar"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="My UPI Account"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Subtitle / Identifier at bottom -->
    <TextView
        android:id="@+id/widget_default_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:singleLine="true"
        android:text="35546649469156"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- Center QR Code (Large, centered with balanced padding) -->
    <ImageView
        android:id="@+id/widget_default_qr"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/widget_default_subtitle"
        android:layout_below="@id/widget_default_header"
        android:layout_centerInParent="true"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:contentDescription="Profile QR Code"
        android:scaleType="fitCenter" />

    <!-- Fallback message when unconfigured (GONE by default) -->
    <TextView
        android:id="@+id/widget_default_empty_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/widget_default_subtitle"
        android:layout_below="@id/widget_default_header"
        android:gravity="center"
        android:padding="8dp"
        android:text="Tap to set default profile in Settings"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:visibility="gone" />

</RelativeLayout>
